{
  "name": "jarvis-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "node electron/dev.cjs",
    "electron:prepare": "node electron/prepare.cjs",
    "electron:start": "electron .",
    "electron:build": "next build && node electron/prepare.cjs && electron-builder --win dir --x64",
    "dist": "next build && node electron/prepare.cjs && electron-builder --win nsis portable --x64",
    "app:install": "next build && node electron/prepare.cjs && node scripts/desktop/make-ico.cjs && node scripts/desktop/seed-settings.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop/install.ps1"
  },
  "main": "electron/main.cjs",
  "description": "Jarvis, asistente de voz en español",
  "author": "William",
  "build": {
    "appId": "uk.w-tech.jarvis",
    "productName": "Jarvis",
    "executableName": "Jarvis",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "electron/main.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules"
      }
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Jarvis-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Jarvis-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "framer-motion": "^13.4.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
